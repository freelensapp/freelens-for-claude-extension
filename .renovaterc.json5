{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled"
  ],
  "prHourlyLimit": 20,
  "addLabels": [
    "renovate"
  ],
  "osvVulnerabilityAlerts": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  // always bump depdenencies even when are in the range
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "rangeStrategy": "bump",
  },
  // disable autorebasing to save unecessary workflow runs
  "rebaseWhen": "conflicted",
  // mise.lock pins a checksum and a URL per tool per platform, but a local
  // `mise install` re-locks only the platform it runs on and silently leaves
  // the others stale. Lock file maintenance runs plain `mise lock`, which
  // refreshes every tool on every platform already in the file. Defaults are
  // disabled and weekly, hence the explicit settings; the packageRules below
  // keep it to mise.lock, since pnpm-lock.yaml is maintained by its own
  // workflows and does not want a periodic refresh PR.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "automerge": true
  },
  "ignoreDeps": [
    // it must be the same as bundled in Electron
    "node",
    // it must be the oldest possible version to get binary compatibility with older OSes
    "ubuntu",
    // must match version from Freelens
    "mobx",
    "mobx-react",
    "react",
    "react-dom",
    "react-router-dom",
  ],
  "packageRules": [
    // lockFileMaintenance is off everywhere except the mise manager (mise.lock);
    // pnpm-lock.yaml has its own refresh workflows and must not get a periodic PR
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "enabled": true
    },
    // group all @freelensapp/* updates into one PR
    {
      "matchPackageNames": [
        "@freelensapp/**"
      ],
      "groupName": "freelensapp"
    },
    // peerDependencies are widen
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen",
      "semanticCommitScope": "peer-deps"
    },
    // non-major updates only
    {
      "matchDepNames": [
        "@types/react",
        "npm",
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    // @testing-library/react v13+ drops React 17 support (requires react-dom/client
    // from React 18+); this extension must stay on React 17 to match the Freelens host
    {
      "matchDepNames": [
        "@testing-library/react",
      ],
      "allowedVersions": "<13"
    },
    // patch updates only
    {
      "matchDepNames": [
        "@types/node",
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    // postupdate script
    {
      "matchDepNames": [
        "@biomejs/biome",
      ],
      "postUpdateOptions": [
        "runScripts"
      ]
    }
  ],
  "customManagers": [
    // additional engine field in package.json
    {
      "customType": "regex",
      "extractVersionTemplate": "^(?<version>.*)$",
      "managerFilePatterns": [
        "/^package\\.json$/"
      ],
      "matchStrings": [
        "\"freelens\"\\s*:\\s*\"(?<currentValue>\\S+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "freelensapp/freelens",
      "versioningTemplate": "npm"
    },
    // pnpm dlx
    {
      "customType": "regex",
      "extractVersionTemplate": "^(?<version>.*)$",
      "managerFilePatterns": [
        "/package\\.json$/"
      ],
      "matchStrings": [
        "pnpm\\s+dlx\\s+(?<depName>\\S+)@(?<currentValue>\\S+?)[\\s\"|<>]"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    // renovate hints after comment
    {
      "customType": "regex",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^\\.trunk/trunk.yaml$/",
        "/^\\.tool-versions$/"
      ],
      "matchStrings": [
        "(\\s+|.*?@)(?<currentValue>\\S+?)!?\\s*#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+versioning=(?<versioning>\\S+))?(\\s+registryUrl=(?<registryUrl>\\S+))?\\s*\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
